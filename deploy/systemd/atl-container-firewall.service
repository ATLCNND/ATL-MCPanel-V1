[Unit]
Description=ATL-MCPanel 容器隔离防火墙规则（容器不得访问宿主服务）
Documentation=https://github.com/ATLCNND/ATL-MCPanel
# 必须在 docker 之后：docker 启动时会重建自己的链，规则要落在它之后。
#
# 但这条规则是按**接口名**匹配的（docker0 是默认网桥，br-+ 覆盖每个实例独占的
# 自定义 bridge），所以它与"网桥此刻是否存在"无关 —— docker 起得晚、或后来
# 才创建实例网络，规则一样生效。这也是它比"在 docker 事件钩子里加规则"更稳的原因。
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# 幂等：先 -C 检查，存在就跳过；重复执行/重复安装不会把规则堆叠起来。
#
# 为什么必须有这两条规则（不是可选加固）：
#   容器**主动**访问宿主服务时，第一个包是新连接（NEW），把来自容器网桥的新连接
#   DROP 掉就掐断了这条路。少了它，实例就能连到宿主上绑 0.0.0.0 的服务
#   （实测能连上 Daemon 的 gRPC 端口），容器隔离等于白做。
#
# ⚠️ 必须限定 `--ctstate NEW`（2026-10-01 内测踩到，代价很大）：
#   原来写的是无条件 `-i br-+ -j DROP`，看起来"只挡容器 → 宿主"，其实**连宿主
#   主动连容器的回程也一起挡了**：docker-proxy 用网桥地址（172.18.0.1）作源去连容器，
#   容器回的 SYN-ACK 目的地址就是宿主的网桥地址 → 属于本机投递 → 命中 INPUT 链 → 被丢。
#   后果是 `-p 127.0.0.1:25565:25565` 这类端口发布整个失效：宿主上连不通容器端口，
#   frpc 也就转不进去，外部 MOTD 工具查实例一律超时。
#   而且它**看起来**是好的 —— TCP 能连上（docker-proxy 会先 accept），只是永远没有
#   数据回来，与"服务端没开 enable-status"极像，很容易查错方向。
#   限定 NEW 之后语义才对：容器主动发起的被挡，宿主发起的那条流的回程是
#   ESTABLISHED，照常放行。
# 2026-10-01 安全审查补充：原来只有 IPv4 一侧。
#   实测（内测节点）：ip6tables 里 INPUT 是**全放行**且没有任何容器规则，
#   而 docker 默认 bridge 的 EnableIPv6=false、容器也没有 IPv6 地址 ——
#   所以现在**不可利用**。但这是"默认配置恰好安全"而不是"规则挡住了"：
#   谁哪天在 /etc/docker/daemon.json 里打开 ipv6，容器就能绕开这层隔离直接连
#   宿主上绑 :: 的服务。补上孪生规则，成本为零，ip6tables 不存在时自动跳过
#   （CentOS 7 / Debian 装了 iptables 就都有）。
ExecStart=/bin/bash -c 'iptables -C INPUT -i br-+ -m conntrack --ctstate NEW -j DROP 2>/dev/null || iptables -I INPUT -i br-+ -m conntrack --ctstate NEW -j DROP; iptables -C INPUT -i docker0 -m conntrack --ctstate NEW -j DROP 2>/dev/null || iptables -I INPUT -i docker0 -m conntrack --ctstate NEW -j DROP; if command -v ip6tables >/dev/null 2>&1; then ip6tables -C INPUT -i br-+ -m conntrack --ctstate NEW -j DROP 2>/dev/null || ip6tables -I INPUT -i br-+ -m conntrack --ctstate NEW -j DROP; ip6tables -C INPUT -i docker0 -m conntrack --ctstate NEW -j DROP 2>/dev/null || ip6tables -I INPUT -i docker0 -m conntrack --ctstate NEW -j DROP; fi'
# 停止时**不删**规则：它们是安全控制，服务停了也不该把口子放开。
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target
